# ==============================================================================
# DECENTRALIZED MULTI-DOCUMENT AUTHENTICATION AND VERIFICATION PLATFORM
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
PUBLIC_VERIFICATION_URL=http://localhost:3000/verify

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL 16)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/document_platform_dev?schema=public

# ------------------------------------------------------------------------------
# CACHE & BACKGROUND QUEUES (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY TOKENS
# (Generate 64-char random hex: openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=e4b78912cf30a912d0912bc7801aef31890123456789abcdef0123456789abcd
JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_SECRET=f5c89023de41ba23e1023cd8912bfa4290123456789bcdef1234567890abcdef
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CRYPTOGRAPHIC KEYS & ENVELOPE ENCRYPTION
# ------------------------------------------------------------------------------
# Master Key Encryption Key (KEK) for AES-256-GCM envelope encryption (32 bytes hex)
KMS_PROVIDER=local
KMS_MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret key for privacy-preserving document lookup index (HMAC-SHA256)
DOCUMENT_HMAC_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# ------------------------------------------------------------------------------
# PRIVATE OBJECT STORAGE (MinIO / S3)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PERMANENT_BUCKET=docauth-permanent-documents
STORAGE_QUARANTINE_BUCKET=docauth-quarantine-uploads
STORAGE_EVIDENCE_BUCKET=docauth-organization-evidence
STORAGE_USE_SSL=false

# ------------------------------------------------------------------------------
# BLOCKCHAIN & SMART CONTRACTS (Polygon PoS)
# ------------------------------------------------------------------------------
# Network Selection: hardhat | polygon-amoy | polygon-mainnet
BLOCKCHAIN_NETWORK=polygon-amoy
BLOCKCHAIN_CHAIN_ID=80002
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/

# Contract Addresses (Populated after deployment)
ISSUER_REGISTRY_ADDRESS=
DOCUMENT_REGISTRY_ADDRESS=

# Relayer Account (Used by background worker to submit and sponsor issuance transactions)
# NEVER commit the actual private key to Git. Store securely in local .env or secret manager.
RELAYER_ADDRESS=
RELAYER_PRIVATE_KEY=
RELAYER_CONFIRMATION_BLOCKS=5

# Deployer Account (Used by Hardhat scripts to deploy contracts)
DEPLOYER_PRIVATE_KEY=

# PolygonScan API Key for contract verification
POLYGONSCAN_API_KEY=

# ------------------------------------------------------------------------------
# NOTIFICATIONS & EMAIL
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@docauth.platform
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

